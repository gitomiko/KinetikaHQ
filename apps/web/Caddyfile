:80 {
  root * /srv
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
    # long cache for fingerprintable static assets; HTML stays fresh
    @assets path /assets/*
    Cache-Control @assets "public, max-age=2592000"
  }

  @health path /healthz
  handle @health {
    respond "ok" 200
  }

  handle_errors {
    @404 expression {http.error.status_code} == 404
    rewrite @404 /404.html
    file_server
  }

  try_files {path} {path}/ {path}.html /index.html
  file_server
}
