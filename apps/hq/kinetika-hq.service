[Unit]
Description=Kinetika HQ static portal
After=network.target

[Service]
Type=simple
User=core
WorkingDirectory=/home/core/KinetkaHQ
EnvironmentFile=-/home/core/KinetkaHQ/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node /home/core/KinetkaHQ/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
